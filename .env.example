# Copy to .env and fill in. Never commit real secrets.

# --- Canonical site origin -------------------------------------------------
# Absolute origin this deployment should present as, with no trailing slash.
# Drives canonical URLs, og:url, JSON-LD @id values and the sitemap. Any origin
# that does not match this one serves a "Disallow: /" robots.txt, so preview and
# staging deployments cannot be indexed by accident.
# Local: http://localhost:3000 · Production: https://dlxproperties.ae
VITE_SITE_URL=https://dlxproperties.ae

# --- Server-side Supabase (SSR, server functions, admin) --------------------
# The service-role key bypasses row-level security. Server only — never expose
# it to the browser, and never prefix it with VITE_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Supabase --------------------------------------------------------------
# Project settings -> Data API / API Keys in the Supabase dashboard.
# The publishable (anon) key is safe to expose to the browser; a service-role
# key never belongs in a VITE_ variable.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
VITE_SUPABASE_PROJECT_ID=your-project-id

# Server-side copies of the same values, read by Edge Functions and SSR.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_PROJECT_ID=your-project-id

# --- Email (Supabase Edge Function secrets) --------------------------------
# Set these on the function, not in this file:
#   npx supabase secrets set RESEND_API_KEY=... LEAD_ADMIN_EMAIL=...
# RESEND_API_KEY   — https://resend.com/api-keys
# LEAD_FROM_EMAIL  — a verified sender, e.g. "DLX Properties <hello@dlxproperties.ae>"
# LEAD_ADMIN_EMAIL — where lead notifications land; comma-separated for several
# SITE_DOMAIN      — bare domain used in email links (defaults to dlxproperties.ae)
# BRAND_PHONE      — phone number shown in the client confirmation
#
# Without RESEND_API_KEY the function logs what it would have sent and returns
# a "skipped" result. Enquiries are still saved; only the emails are missing.

# --- DLD data engine (Edge Function secrets) --------------------------------
# Register for Dubai Pulse DLD dataset access at https://www.dubaipulse.gov.ae
#   npx supabase secrets set DUBAI_PULSE_CLIENT_ID=... DUBAI_PULSE_CLIENT_SECRET=...
# DUBAI_PULSE_CLIENT_ID / DUBAI_PULSE_CLIENT_SECRET — OAuth client credentials
# DUBAI_PULSE_TOKEN_URL / DUBAI_PULSE_API_BASE      — override if the portal moves them
# DLD_SYNC_SECRET — shared secret the scheduler and the admin re-sync present.
#   Set the same value here (for the admin trigger) and as a function secret.
DLD_SYNC_SECRET=choose-a-long-random-string

# --- AI advisor: chat (server-side only) ------------------------------------
# The chat runs on Lovable AI, which is OpenAI-compatible. Without a key the
# advisor does not appear at all: the dock is rendered only when the server says
# it can answer, because an advisor that invites a question and then fails is
# worse than none.
# LOVABLE_API_KEY — the gateway key. Never a VITE_ variable; it must not reach
#   the browser, which is why the chat goes through /api/advisor/chat.
LOVABLE_API_KEY=
# Optional overrides. Any OpenAI-compatible gateway works.
# ADVISOR_API_URL=https://ai.gateway.lovable.dev/v1/chat/completions
# ADVISOR_MODEL=google/gemini-2.5-flash

# --- AI advisor: voice ------------------------------------------------------
# Fish Audio gives the advisor one voice across the phone line and the "Listen"
# control in the chat. Unset, both degrade to text rather than erroring.
# FISH_AUDIO_API_KEY  — https://fish.audio account
# FISH_AUDIO_VOICE_ID — the reference model to speak with; optional
# FISH_AUDIO_API_URL  — override for a region or a self-hosted endpoint
FISH_AUDIO_API_KEY=

# Shared secret proving that a request to the voice endpoints really is the
# telephony layer. Set the SAME value in three places: here (for
# /api/advisor/voice and /api/advisor/call-lead), as a function secret for
# advisor-call-summary, and in the telephony provider's webhook configuration.
#   npx supabase secrets set VOICE_WEBHOOK_SECRET=... SITE_URL=https://...
# Unset, the voice endpoints refuse every request rather than defaulting open.
VOICE_WEBHOOK_SECRET=choose-a-long-random-string

# --- Paid media: browser tags (public by nature) ----------------------------
# These ship in the page for anyone to read, which is why they are VITE_. The
# tokens that let a server *write* conversions are further down and are not.
# An unconfigured platform is simply never loaded — no script, no requests — so
# a deployment without ad accounts behaves as it did before Phase 6.
VITE_META_PIXEL_ID=
VITE_GA4_MEASUREMENT_ID=
VITE_GOOGLE_ADS_ID=
# Conversion labels as LEAD:AbC-D_efGh,CALL:XyZ… — one variable rather than six,
# so the deployment config stays something a person can paste.
VITE_GOOGLE_ADS_LABELS=

# --- Paid media: server-side conversions ------------------------------------
# The Conversions API copy of every lead, deduplicated against the browser
# pixel by a shared event id. Contact details are SHA-256 hashed before they
# leave. Unset, nothing is dispatched and nothing is logged as if it were.
META_PIXEL_ID=
META_CAPI_TOKEN=
# Optional: routes events to Meta's test console instead of the live dataset.
# META_TEST_EVENT_CODE=

# Google Ads offline conversions go through a thin relay you deploy — a Cloud
# Function, a Zap, an Apps Script — because the Ads API needs an OAuth dance
# this codebase has no other use for. Swapping it for the real API later is a
# change behind one function.
# GOOGLE_ADS_CONVERSION_URL=
# GOOGLE_ADS_CONVERSION_SECRET=

# --- Spam protection --------------------------------------------------------
# Cloudflare Turnstile. Without a key the widget renders nothing and the server
# treats a missing token as "no opinion" rather than as a failure — a missing
# key degrades to the protection the site had before, never blocking enquiries.
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Native lead forms ------------------------------------------------------
# Meta Instant Forms. The webhook carries only a leadgen id; the answers are
# fetched with the page token, so a stolen payload is worth nothing.
# META_APP_SECRET           — signs the webhook; checked against the raw bytes
# META_WEBHOOK_VERIFY_TOKEN — echoed during Meta's subscription handshake
# META_PAGE_ACCESS_TOKEN    — reads the lead's answers
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_PAGE_ACCESS_TOKEN=

# Google Lead Form Extensions post the answers directly, authenticated by this
# shared key. Unset, the endpoint refuses every request rather than defaulting
# open — it is the only thing between it and anyone who guesses the URL.
GOOGLE_LEAD_FORM_KEY=

# --- Nurture (Edge Function secret) -----------------------------------------
# Signs the unsubscribe link so the URL cannot be walked to unsubscribe someone
# else. Falls back to DLD_SYNC_SECRET when unset.
#   npx supabase secrets set NURTURE_SECRET=... SITE_URL=https://...
NURTURE_SECRET=

# --- Phase 7: launch -------------------------------------------------------

# Where server errors are posted. Any endpoint that accepts a JSON POST — a
# Sentry relay, a Slack incoming webhook, a log collector. Without it, errors
# reach the process log and nowhere else, which on a self-hosted deploy means
# nobody finds out. See src/data/monitoring.server.ts for the payload, which
# deliberately carries no lead data.
ERROR_WEBHOOK_URL=
# Optional bearer token for the endpoint above.
ERROR_WEBHOOK_TOKEN=
